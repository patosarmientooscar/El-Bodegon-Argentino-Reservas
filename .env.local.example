NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Acceso directo sin login (opcional). Con las dos rellenas, el panel entra
# solo con esta cuenta y no muestra /login. Vacías = vuelve a pedir login.
# Solo de servidor: nunca les pongas el prefijo NEXT_PUBLIC_.
AUTO_LOGIN_EMAIL=
AUTO_LOGIN_PASSWORD=

# --- Avisos por Telegram (Fase 1) ---------------------------------------------
# Solo de servidor (sin NEXT_PUBLIC_). En Vercel: Settings → Environment Variables.
# Clave "service_role" / "secret" de Supabase (Project Settings → API keys).
# La usan solo los webhooks para cambiar el estado desde Telegram.
SUPABASE_SERVICE_ROLE_KEY=
# Token que da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# chat_id que reciben avisos y pueden aceptar/rechazar, separados por comas.
TELEGRAM_CHAT_IDS=
# Secretos largos y aleatorios (p. ej. `openssl rand -hex 32`).
TELEGRAM_WEBHOOK_SECRET=
RESERVATION_WEBHOOK_SECRET=
# URL pública del panel (la usa npm run telegram:setup).
APP_URL=https://el-bodegon-argentino-reservas.vercel.app
