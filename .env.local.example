NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Acceso directo sin login (opcional). Con las dos rellenas, el panel entra
# solo con esta cuenta y no muestra /login. Vacías = vuelve a pedir login.
# Solo de servidor: nunca les pongas el prefijo NEXT_PUBLIC_.
AUTO_LOGIN_EMAIL=
AUTO_LOGIN_PASSWORD=

# --- Avisos de reservas al móvil (notificaciones push) -------------------------
# Todas de servidor (sin NEXT_PUBLIC_). En Vercel: Settings → Environment Variables.
# Clave "service_role" / "secret" de Supabase (Project Settings → API keys).
# Solo la usa el servidor para leer los móviles a los que avisar.
SUPABASE_SERVICE_ROLE_KEY=
# Texto largo y aleatorio; el mismo que va en PEGAR_AVISOS_RESERVAS.sql.
RESERVATION_WEBHOOK_SECRET=
# Claves VAPID: se generan con `npm run push:keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios de push (opcional).
VAPID_SUBJECT=mailto:elbodegonargentino.es@gmail.com

# --- Futuro / opcional: avisos por Telegram (apagado si no hay token) ----------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
# TELEGRAM_WEBHOOK_SECRET=
# APP_URL=https://el-bodegon-argentino-reservas.vercel.app
